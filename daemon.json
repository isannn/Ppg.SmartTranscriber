{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3",
    "labels": "production_status",
    "env": "os,customer",
    "mode": "non-blocking",
    "max-buffer-size": "25m"
  },
  "debug": false,
  "experimental": false,
  "features": {
    "otel": false
  },
  "metrics-addr": "",
  "otel": {
    "enabled": false
  }
} 
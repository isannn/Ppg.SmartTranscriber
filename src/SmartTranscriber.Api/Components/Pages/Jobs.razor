@page "/jobs"
@rendermode InteractiveServer
@inject IJobService JobService
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Jobs — SmartTranscriber</PageTitle>

<h2>Transcription jobs</h2>

<button class="btn btn-sm btn-secondary mb-2" @onclick="LoadAsync">Refresh</button>

@if (_jobs is null)
{
    <p>Loading…</p>
}
else if (_jobs.Count == 0)
{
    <p>No transcription jobs found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>File</th>
                <th>Status</th>
                <th>Created</th>
                <th>Model</th>
                <th>Error</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in _jobs)
            {
                <tr>
                    <td>@job.OriginalFileName</td>
                    <td>
                        @job.Status
                        @if (job.Status is not (nameof(JobStatus.Done) or nameof(JobStatus.Failed) or nameof(JobStatus.Cancelled)))
                        {
                            <div class="progress" style="height:6px; min-width:90px">
                                <div class="progress-bar" role="progressbar" style="width:@job.Progress%"></div>
                            </div>
                            <small>@job.Progress%</small>
                        }
                    </td>
                    <td>@job.CreatedAt.ToString("g")</td>
                    <td>@job.Model</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(job.ErrorMessage))
                        {
                            <span class="text-danger">@job.ErrorMessage</span>
                        }
                    </td>
                    <td>
                        @if (job.Status == nameof(JobStatus.Done))
                        {
                            <a class="btn btn-sm btn-primary" href="/jobs/@job.Id">View</a>
                        }
                        @if (job.Status is nameof(JobStatus.Failed) or nameof(JobStatus.Cancelled))
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => RetryAsync(job.Id)">Retry</button>
                        }
                        @if (job.Status is nameof(JobStatus.Pending) or nameof(JobStatus.Downloading) or nameof(JobStatus.Processing))
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelAsync(job.Id)">Cancel</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<JobDto>? _jobs;
    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await ConnectHubAsync();
    }

    private async Task ConnectHubAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.BaseUri.TrimEnd('/') + "/hubs/progress")
                .Build();
            _hub.On<JobUpdateDto>(ProgressHub.EventName, OnJobUpdate);
            await _hub.StartAsync();
            if (_jobs is not null)
            {
                foreach (var j in _jobs.Where(j => j.Status is not ("Done" or "Failed" or "Cancelled")))
                {
                    await _hub.InvokeAsync("JoinJob", j.Id.ToString());
                }
            }
        }
        catch
        {
            _hub = null; // realtime is best-effort
        }
    }

    private void OnJobUpdate(JobUpdateDto u)
    {
        _ = InvokeAsync(() =>
        {
            if (_jobs is null)
            {
                return;
            }
            _jobs = _jobs.Select(j => j.Id == u.JobId
                ? j with { Progress = u.Progress ?? j.Progress, Status = u.Status ?? j.Status }
                : j).ToList();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }

    private async Task RetryAsync(Guid id)
    {
        await JobService.RetryJobAsync(id);
        await LoadAsync();
    }

    private async Task CancelAsync(Guid id)
    {
        await JobService.CancelJobAsync(id);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _jobs = await JobService.ListJobsAsync(null, null, 100, 0);
    }
}

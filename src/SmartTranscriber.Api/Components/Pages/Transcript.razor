@page "/jobs/{Id:guid}"
@rendermode InteractiveServer
@inject ITranscriptService Transcripts
@inject IJobService Jobs
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<SmartTranscriber.Core.Options.SmartTranscriberOptions> Opt
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Transcript — SmartTranscriber</PageTitle>

<h2>Transcript</h2>

@if (_job is not null)
{
    <p>
        <strong>@_job.OriginalFileName</strong> — @_job.Status
        @if (_job.Status is not ("Done" or "Failed"))
        {
            <span class="d-inline-block align-middle" style="width:120px">
                <span class="progress" style="height:6px">
                    <span class="progress-bar" style="width:@_job.Progress%"></span>
                </span>
                <small>@_job.Progress%</small>
            </span>
        }
        |
        <a href="/api/v1/jobs/@Id/transcript" download>.txt</a> ·
        <a href="/api/v1/jobs/@Id/transcript?format=srt">.srt</a> ·
        <a href="/api/v1/jobs/@Id/transcript?format=vtt">.vtt</a> ·
        <a href="/api/v1/jobs/@Id/transcript?format=json">.json</a>
        <button class="btn btn-sm btn-outline-primary ms-3" @onclick="SummarizeAsync" disabled="@_summarizing">
            @(_summarizing ? "Summarizing…" : "Generate summary")
        </button>
    </p>
    @if (SmartTranscriber.Core.MediaTypes.IsVideo(_job.OriginalFileName))
    {
        <video @ref="_player" controls src="@MediaSrc" style="width:100%; max-height:360px;" class="mb-3"></video>
    }
    else
    {
        <audio @ref="_player" controls src="@MediaSrc" style="width:100%;" class="mb-3"></audio>
    }
}
@if (_summaryError is not null)
{
    <div class="alert alert-danger">@_summaryError</div>
}
@if (_summary is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Summary</h5>
            <pre style="white-space:pre-wrap">@_summary</pre>
        </div>
    </div>
}

@if (_segments is null)
{
    <p>Loading…</p>
}
else if (_segments.Count == 0)
{
    <p>No segments found.</p>
}
else
{
    <div class="input-group input-group-sm mb-2" style="max-width:560px">
        <span class="input-group-text">Rename / merge speaker</span>
        <input class="form-control" placeholder="SPEAKER_00" @bind="_renameFrom" />
        <input class="form-control" placeholder="New name" @bind="_renameTo" />
        <button class="btn btn-outline-primary" @onclick="RenameSpeakerAsync"
                disabled="@(string.IsNullOrWhiteSpace(_renameFrom) || string.IsNullOrWhiteSpace(_renameTo))">Apply</button>
    </div>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Start</th>
                <th>End</th>
                <th>Speaker</th>
                <th>Text</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _segments)
            {
                var lowConf = s.Confidence is < LowConfidenceThreshold;
                <tr data-start="@s.StartTime" data-end="@s.EndTime" style="cursor:pointer"
                    class="@(lowConf ? "table-warning" : "")"
                    title="@(lowConf ? $"low ASR confidence: {s.Confidence:0.00}" : null)"
                    @onclick="() => SeekAsync(s.StartTime)">
                    <td>@Fmt(s.StartTime)</td>
                    <td>@Fmt(s.EndTime)</td>
                    <td>
                        <input class="form-control form-control-sm"
                               value="@s.Speaker"
                               @onclick:stopPropagation="true"
                               @onchange="e => SaveSpeakerAsync(s, e.Value?.ToString())" />
                    </td>
                    <td>
                        <input class="form-control form-control-sm"
                               value="@s.Text"
                               @onclick:stopPropagation="true"
                               @onchange="e => SaveTextAsync(s, e.Value?.ToString())" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private IReadOnlyList<SegmentDto>? _segments;
    private JobDto? _job;
    private ElementReference _player;
    private bool _bound;
    private HubConnection? _hub;

    private string? _summary;
    private string? _summaryError;
    private bool _summarizing;

    protected override async Task OnInitializedAsync()
    {
        _job = await Jobs.GetJobAsync(Id);
        _segments = await Transcripts.GetSegmentsAsync(Id);
        _summary = _job?.Summary;
        await ConnectHubAsync();
    }

    private async Task ConnectHubAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.BaseUri.TrimEnd('/') + "/hubs/progress")
                .Build();
            _hub.On<JobUpdateDto>(ProgressHub.EventName, OnJobUpdate);
            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinJob", Id.ToString());
        }
        catch
        {
            _hub = null; // realtime is best-effort
        }
    }

    private async Task OnJobUpdate(JobUpdateDto u)
    {
        if (u.JobId != Id || _job is null)
        {
            return;
        }
        await InvokeAsync(async () =>
        {
            _job = _job with
            {
                Progress = u.Progress ?? _job.Progress,
                Status = u.Status ?? _job.Status
            };
            // terminal state reached — pull final data once
            if (u.Status is "Done" or "Failed" && (_segments is null || _segments.Count == 0))
            {
                _job = await Jobs.GetJobAsync(Id) ?? _job;
                _segments = await Transcripts.GetSegmentsAsync(Id);
                _summary = _job.Summary;
            }
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }

    private async Task SummarizeAsync()
    {
        _summarizing = true;
        _summaryError = null;
        try
        {
            var result = await Transcripts.GetOrCreateSummaryAsync(Id, regenerate: true);
            _summary = result?.Summary;
        }
        catch (Exception ex)
        {
            _summaryError = ex.Message;
        }
        finally
        {
            _summarizing = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_bound && _job is not null && _segments is not null)
        {
            _bound = true;
            try { await JS.InvokeVoidAsync("stMedia.bind", _player); }
            catch (JSException) { /* player not rendered yet */ }
        }
    }

    private async Task SeekAsync(double seconds)
    {
        try { await JS.InvokeVoidAsync("stMedia.seek", _player, seconds); }
        catch (JSException) { /* no player */ }
    }

    private string _renameFrom = "";
    private string _renameTo = "";
    private string MediaSrc =>
        $"/api/v1/jobs/{Id}/media" +
        (string.IsNullOrEmpty(Opt.Value.Auth.Token) ? "" : $"?token={Uri.EscapeDataString(Opt.Value.Auth.Token)}");

    private async Task RenameSpeakerAsync()
    {
        var updated = await Transcripts.RenameSpeakerAsync(Id, _renameFrom.Trim(), _renameTo.Trim());
        if (updated > 0)
        {
            _segments = await Transcripts.GetSegmentsAsync(Id);
        }
    }

    private async Task SaveSpeakerAsync(SegmentDto segment, string? speaker)
    {
        await Transcripts.UpdateSpeakerAsync(segment.Id, speaker);
    }

    private async Task SaveTextAsync(SegmentDto segment, string? text)
    {
        if (!string.IsNullOrWhiteSpace(text))
        {
            await Transcripts.UpdateTextAsync(segment.Id, text);
        }
    }

    private const double LowConfidenceThreshold = 0.6;

    private static string Fmt(double seconds)
        => TimeSpan.FromSeconds(seconds).ToString(@"hh\:mm\:ss");
}

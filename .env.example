# Runtime secrets come from Infisical (see specs/FR-062-infisical-secrets).
# Copy to .env and fill the bootstrap values; leave INFISICAL_TOKEN empty
# to run fully on local env vars (dev fallback).

INFISICAL_URL=http://127.0.0.1:8464
INFISICAL_PROJECT_ID=<project-uuid>
INFISICAL_TOKEN=<machine-identity token>
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/smarttranscriber

# Used by docker-compose / stt_svc sidecar (not pulled by the API from Infisical)
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
HF_TOKEN=
DEVIN_OPENAI_API_KEY=
